generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  email       String?
  phone       String?
  logoUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branches    Branch[]
  courses     Course[]
  enrollments Enrollment[]
  roles       Role[]
  states      State[]
  students    Student[]
  users       User[]
  exams       Exam[]
}

model State {
  id             String       @id @default(uuid())
  name           String
  code           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branches       Branch[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model Branch {
  id             String         @id @default(uuid())
  name           String
  code           String
  address        String?
  city           String?
  phone          String?
  organizationId String
  stateId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batches        Batch[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  state          State          @relation(fields: [stateId], references: [id])
  courses        BranchCourse[]
  enrollments    Enrollment[]
  students       Student[]
  users          User[]
  exams          Exam[]

  @@unique([organizationId, code])
}

model Course {
  id             String         @id @default(uuid())
  name           String
  code           String
  description    String?
  durationMonths Int?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batches        Batch[]
  branches       BranchCourse[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  exams          Exam[]

  @@unique([organizationId, code])
}

model BranchCourse {
  id        String   @id @default(uuid())
  branchId  String
  courseId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([branchId, courseId])
}

model Batch {
  id          String       @id @default(uuid())
  name        String
  code        String
  startDate   DateTime
  endDate     DateTime?
  capacity    Int?
  status      BatchStatus  @default(UPCOMING)
  branchId    String
  courseId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id])
  enrollments Enrollment[]
  exams       Exam[]

  @@unique([branchId, code])
}

model Student {
  id             String        @id @default(uuid())
  studentCode    String
  name           String
  fatherName     String?
  motherName     String?
  dateOfBirth    DateTime?
  gender         String?
  aadharNumber   String?
  phone          String?
  email          String?
  address        String?
  city           String?
  district       String?
  status         StudentStatus @default(ACTIVE)
  organizationId String
  branchId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  examResults    ExamResult[]

  enrollments  Enrollment[]
  branch       Branch       @relation(fields: [branchId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, studentCode])
  @@index([aadharNumber])
}

model Enrollment {
  id               String            @id @default(uuid())
  enrollmentNumber String?
  year             Int?
  session          String?
  admissionDate    DateTime          @default(now())
  completionDate   DateTime?
  employmentStatus EmploymentStatus?

  studentId      String
  organizationId String
  branchId       String
  courseId       String
  batchId        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch        Batch        @relation(fields: [batchId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  course       Course       @relation(fields: [courseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeStructure FeeStructure?
  examResults  ExamResult[]

  @@unique([organizationId, enrollmentNumber])
  @@index([studentId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([year])
  @@index([employmentStatus])
}

model Exam {
  id           String   @id @default(uuid())
  name         String
  examType     String   @default("THEORY")
  examDate     DateTime
  maxMarks     Decimal  @db.Decimal(10, 2)
  passingMarks Decimal  @db.Decimal(10, 2)
  status       ExamStatus @default(DRAFT)

  organizationId String
  branchId       String
  courseId       String
  batchId        String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  course       Course       @relation(fields: [courseId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])
  results      ExamResult[]
  questions ExamQuestion[]


  @@index([organizationId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([examDate])
}
model ExamQuestion {
  id            String   @id @default(uuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  marks         Decimal  @default(1) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamResult {
  id           String @id @default(uuid())
  examId       String
  studentId    String
  enrollmentId String

  marks      Decimal          @db.Decimal(10, 2)
  percentage Decimal          @db.Decimal(5, 2)
  result     ExamResultStatus
  remarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([examId])
}

model FeeStructure {
  id           String    @id @default(uuid())
  enrollmentId String
  totalAmount  Decimal   @db.Decimal(10, 2)
  discount     Decimal   @default(0) @db.Decimal(10, 2)
  finalAmount  Decimal   @db.Decimal(10, 2)
  status       FeeStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payments   Payment[]
  subsidy    Subsidy?

  @@unique([enrollmentId])
  @@index([enrollmentId])
}

model Subsidy {
  id             String      @id @default(uuid())
  feeStructureId String      @unique
  type           SubsidyType
  amount         Decimal     @db.Decimal(10, 2)
  letterUrl      String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model Payment {
  id             String        @id @default(uuid())
  feeStructureId String
  amount         Decimal       @db.Decimal(10, 2)
  paymentDate    DateTime      @default(now())
  paymentMethod  PaymentMethod @default(CASH)
  receiptNumber  String        @unique
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}



model User {
  id             String       @id @default(uuid())
  name           String
  email          String
  passwordHash   String?
  status         UserStatus   @default(ACTIVE)
  organizationId String
  branchId       String?
  roleId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, email])
}

model Role {
  id             String           @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          User[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  TRANSFERRED
  ON_HOLD
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SubsidyType {
  BPL
  GOVT_SCHOOL_LETTER
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  ENTREPRENEUR
  HIGHER_EDUCATION
  INTERESTED_FOR_JOB
  NOT_INTERESTED
  NOT_PLACED
  OTHER
}

enum ExamType {
  INTERNAL
  FINAL
  PRACTICAL
  ASSESSMENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  RESULTS_PUBLISHED
}

enum ExamResultStatus {
  PASS
  FAIL
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}